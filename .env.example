# Supabase project settings (use the service role key only on the server).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Local backend and optional frontend origin for CORS.
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Public frontend setting. Leave blank for same-origin Vercel deployment.
VITE_API_URL=
