{
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/staff",
      "destination": "/index.html"
    },
    {
      "source": "/staff/(.*)",
      "destination": "/index.html"
    }
  ]
}
